# Copy to .env for running the backend outside Docker.
PEDIVEIN_DATABASE_URL=postgresql+psycopg://pedivein:pedivein@localhost:5434/pedivein
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
PEDIVEIN_JWT_SECRET=change-me
PEDIVEIN_AI_BASE_URL=http://127.0.0.1:8000
# Must match PEDIVEIN_API_KEY of backend_ai_cpu when that is set
PEDIVEIN_AI_API_KEY=
PEDIVEIN_UPLOAD_DIR=uploads
PEDIVEIN_SEED_DEMO_DATA=true
PEDIVEIN_DEMO_PASSWORD=pedivein1234
# Set true behind HTTPS
PEDIVEIN_COOKIE_SECURE=false
